# Copie para .env (raiz, usado pelo docker-compose) e/ou backend/.env (dev local sem Docker).
# Nenhuma variável é obrigatória no dev local: sem DATABASE_URL usa SQLite em
# backend/dados/medprecos.db; sem REDIS_URL as tarefas rodam numa thread da API.

# --- docker-compose ---
POSTGRES_PASSWORD=troque-esta-senha
MEDPRECOS_PORTA=8731

# --- aplicação (valem nos dois modos) ---
# DATABASE_URL=postgresql+psycopg://medprecos:senha@localhost:5432/medprecos
# REDIS_URL=redis://localhost:6379/0
# Token que libera POST /api/tarefas/{nome} (vazio = endpoint desligado)
ADMIN_TOKEN=
# Camada C - TTL dos caches
TTL_PRECO_HORAS=24
TTL_FARMACIAS_HORAS=24
TTL_GEOCODIFICACAO_DIAS=30
TIMEOUT_SOB_DEMANDA_S=6

# Lomadee Affiliate API (chave só leitura: brands, campaigns, products) - criada em app.lomadee.com.br/api-keys
LOMADEE_API_KEY=
